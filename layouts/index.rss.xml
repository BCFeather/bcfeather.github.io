{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ .Permalink }}</id>
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.tagline }}</subtitle>
  <updated>{{ now.Format "2006-01-02T15:04:05-07:00" }}</updated>
  <author>
    <name>{{ site.Params.socialName }}</name>
    <uri>{{ site.BaseURL }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ "feed.xml" | absURL }}"/>
  <link rel="alternate" type="text/html" hreflang="en" href="{{ .Permalink }}"/>
  <generator uri="https://gohugo.io/">Hugo</generator>
  <rights>© {{ now.Year }} {{ site.Params.socialName }}</rights>
  <icon>/assets/img/favicons/favicon.ico</icon>
  <logo>/assets/img/favicons/favicon-96x96.png</logo>
  {{- range first 10 (where site.RegularPages "Type" "posts").ByDate.Reverse }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html" title="{{ .Title }}"/>
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</updated>
    <id>{{ .Permalink }}</id>
    <author>
      <name>{{ site.Params.socialName }}</name>
    </author>
    {{- with .Params.categories }}
    <category term="{{ index . 0 }}"/>
    {{- end }}
    <summary>{{ with .Description }}{{ . }}{{ else }}{{ .Summary | plainify }}{{ end }}</summary>
  </entry>
  {{- end }}
</feed>
