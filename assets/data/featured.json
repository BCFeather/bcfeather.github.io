{"p":[{% for post in site.posts %}{"u":{{ post.url | relative_url | jsonify }},"t":{{ post.title | jsonify }},"d":{{ post.date | date: "%-d %b %Y" | jsonify }},"s":{{ post.description | default: "" | markdownify | strip_html | strip_newlines | truncate: 120 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
